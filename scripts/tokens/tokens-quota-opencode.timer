[Unit]
Description=report the OpenCode Go subscription quota every 30 minutes

[Timer]
# Same cadence as the other two legs, offset from both: separate reports
# to separate rows, with nothing to gain from waking together.
OnBootSec=8min
OnUnitActiveSec=30min
RandomizedDelaySec=2min
Persistent=true

[Install]
WantedBy=timers.target
