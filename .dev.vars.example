# Local secrets for `npm run dev`. Copy to .dev.vars (gitignored) and fill in.
# In production each is a Worker secret: npx wrangler secret put <NAME>

# Bearer token for the tokens CLI and the quota collectors.
TOKENS_API_TOKEN=
# Bearer token for POST /switch/sync.
SWITCH_API_TOKEN=
# Nintendo Account session token scoped to the Parental Controls app.
PCTL_SESSION_TOKEN=
# AirTrail API key.
AIRTRAIL_API_KEY=
# Read-only personal access token for Wealthfolio's MCP endpoint
# (Settings → AI agent access, read scopes only): the portfolio's money.
# WEALTHFOLIO_URL itself is a plain var in wrangler.jsonc.
WEALTHFOLIO_TOKEN=
# Security token of the Ghostfolio bot user the portfolio service signs in as.
GHOSTFOLIO_TOKEN=
# logo.dev publishable key, for the portfolio logos.
LOGO_DEV_TOKEN=
