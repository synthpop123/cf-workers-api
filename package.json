{
  "name": "cf-workers-api",
  "version": "1.0.0",
  "private": true,
  "description": "Every backend lkwplus.com reads, in one Cloudflare Worker at api.lkwplus.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synthpop123/cf-workers-api.git"
  },
  "keywords": [
    "cloudflare-workers",
    "d1",
    "kv",
    "r2",
    "personal-api"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types",
    "test": "vitest run",
    "format": "biome format --write",
    "lint": "biome check --error-on-warnings",
    "check": "npm run types && npm run lint && tsc -p test --noEmit && vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.145.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "fsevents": true
  }
}
